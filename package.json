{
  "name": "self-hosted-control-center",
  "version": "0.3.1",
  "description": "A local-first, settings-driven business intelligence dashboard.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "launch": "node scripts/launch.mjs",
    "doctor": "node scripts/doctor.mjs",
    "backup": "node scripts/backup.mjs",
    "ingest": "node scripts/ingest.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run lint && npm test && npm run build",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "build:mcp": "wrangler deploy --dry-run --config wrangler.mcp.jsonc",
    "build:intel": "wrangler deploy --dry-run --config wrangler.intel.jsonc",
    "build:todoist": "wrangler deploy --dry-run --config wrangler.todoist.jsonc",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:mcp": "wrangler deploy --config wrangler.mcp.jsonc",
    "deploy:intel": "wrangler deploy --config wrangler.intel.jsonc",
    "deploy:todoist": "wrangler deploy --config wrangler.todoist.jsonc"
  },
  "packageManager": "npm@11.19.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mreflow/control-center.git"
  },
  "homepage": "https://github.com/mreflow/control-center#readme",
  "bugs": {
    "url": "https://github.com/mreflow/control-center/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "fast-xml-parser": "^5.11.0",
    "jose": "6.2.12",
    "lucide-react": "^0.563.0",
    "next": "16.3.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "^1.0.0-beta.9",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vite": "^8.3.0",
    "wrangler": "^4.131.1"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "sharp": "0.35.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  },
  "type": "module"
}
